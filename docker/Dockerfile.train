# Stage 1: Base image with Python and dependencies
FROM python:3.11-slim AS base
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY requirements/train.txt .
RUN pip install --no-cache-dir -r requirements/train.txt

# Stage 2: Training runtime
FROM base AS training

# Create a non-root group and user for security compliance
RUN groupadd -g 999 appgroup && \
    useradd -r -u 999 -g appgroup appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app

USER appuser

# Copy training and parameter files
COPY --chown=appuser:appgroup src/ ./src/
COPY --chown=appuser:appgroup config/ ./config/

# flush output streams to avoid buffering issues in logs
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV TRAINING_CONFIG_PATH=/app/configs/training_config.yaml

ENTRYPOINT ["python", "src/train.py"]
