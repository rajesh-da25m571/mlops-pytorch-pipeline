FROM python:3.11-slim AS base

WORKDIR /app

# Minimal C++ and image libraries required by torchvision and OS
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# Install all dependencies directly from requirements
COPY requirements/train.txt .
RUN pip install --no-cache-dir -r train.txt

FROM base AS training

RUN groupadd -g 999 appgroup && \
    useradd -r -u 999 -g appgroup appuser && \
    mkdir -p /app/data && \
    chown -R appuser:appgroup /app

USER appuser

COPY --chown=appuser:appgroup src/ ./src/
COPY --chown=appuser:appgroup configs/ ./configs/

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src
ENV TRAINING_CONFIG_PATH=/app/configs/training_config.yaml

ENTRYPOINT ["python", "src/train.py"]